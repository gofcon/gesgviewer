# =============================================================
# ESG PyQt6 — .gitignore
# =============================================================

# ── Python 캐시 ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── 가상 환경 ────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── PyInstaller 빌드 산출물 ──────────────────────────────────
build/
dist/
*.spec
# spec 파일은 보통 커밋하지만, 자동 생성된 경우 제외
# esg_app.spec  ← 직접 관리하는 경우 이 줄을 주석 처리

# ── DB 파일 (SQLite) ─────────────────────────────────────────
data/
*.db
*.sqlite
*.sqlite3

# ── 엑셀 내보내기 파일 ────────────────────────────────────────
exports/
*.xlsx
*.xls
*.csv

# ── IDE / 에디터 설정 ────────────────────────────────────────
.vscode/
*.code-workspace
.idea/
*.swp
*.swo
*~

# ── OS 생성 파일 ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 로그 파일 ────────────────────────────────────────────────
*.log
logs/

# ── 테스트 / 커버리지 ─────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── 패키징 / 배포 ─────────────────────────────────────────────
*.egg-info/
dist/
.eggs/
MANIFEST

# ── 임시 / 백업 파일 ──────────────────────────────────────────
*.tmp
*.bak
*.orig
